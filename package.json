{
  "name": "ev-manager",
  "private": true,
  "version": "4.9.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:native": "tsc -b && vite build --base=./",
    "lint": "eslint .",
    "preview": "vite preview",
    "check-k35": "bash scripts/check-no-k35.sh",
    "setup-hooks": "git config core.hooksPath .githooks && chmod +x .githooks/pre-commit scripts/check-no-k35.sh",
    "cap:init": "npx cap init 'EV Manager' jp.gmail.yamaga101.evmanager --web-dir=dist",
    "cap:android:add": "npx cap add android",
    "cap:sync": "npm run build:native && npx cap sync android",
    "cap:open": "npx cap open android",
    "cap:run": "npm run build:native && npx cap run android",
    "cap:livereload": "npx cap run android --livereload --external --port 5173",
    "cap:logcat": "adb logcat -v time *:S Capacitor:V chromium:V evmanager:V CapacitorPlugin:V CapacitorWebView:V TSLocationManager:V",
    "cap:logcat:errors": "adb logcat -v time *:E -d | tail -100",
    "adb:wireless": "echo '次の 2 step を志柿端末で実行してください:'  && echo '1) S25 Ultra を Mac と USB 接続してこのコマンド: adb tcpip 5555' && echo '2) 設定 → 開発者向けオプション → ワイヤレスデバッグ ON で IP 確認 (例 192.168.x.y:5555) → adb connect 192.168.x.y:5555'",
    "release-apk": "bash scripts/release-apk.sh",
    "ship-apk": "npm run cap:sync && npm run release-apk"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/preferences": "^7.0.0",
    "@transistorsoft/capacitor-background-fetch": "^7.0.0",
    "@transistorsoft/capacitor-background-geolocation": "^7.0.0",
    "lucide-react": "^0.511.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^2.15.3",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.1.0"
  }
}
